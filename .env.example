# ==============================================================================
# ReconcileX Environment Configuration
# ==============================================================================

# LLM Reasoning Engine Mode: "local" (Ollama) or "cloud" (gemini / anthropic / openai)
RECONCILEX_LLM_PROVIDER=local

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Cloud API Keys (Optional Fallbacks)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OCR Engine Mode: "auto", "easyocr", "tesseract", "ollama_vlm", "gemini_vision"
RECONCILEX_OCR_ENGINE=auto

# Reconciliation Deterministic Defaults
RECONCILEX_DATE_TOLERANCE_DAYS=3
RECONCILEX_VENDOR_SIMILARITY_THRESHOLD=75.0
RECONCILEX_FEE_TOLERANCE_AMOUNT=25.0
RECONCILEX_MAX_BUNDLE_COMBINATIONS=4

# Server and Dashboard Settings
RECONCILEX_HOST=127.0.0.1
RECONCILEX_PORT=8585
RECONCILEX_DATA_DIR=./data
RECONCILEX_LOG_LEVEL=INFO
